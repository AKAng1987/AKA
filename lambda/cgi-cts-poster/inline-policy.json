 {"Sid":"ListOnlyToReportMissingAsNoSuchKey","Effect":"Allow","Action":"s3:ListBucket",
  "Resource":"arn:aws:s3:::cmon-stage-backend-369568916817-ap-southeast-1-reports",
  "Condition":{"StringEquals":{"s3:prefix":["State/cts_alerts_posted.json"]}}}
]}
